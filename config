# [preference] declare user definitions first
include ~/.config/sway/userprefs
# my sacred keybinds - best of the best, if you ask me. Perfect workflow for my PC
include ~/.config/sway/bindings
# [preference] input config and keyboard layouts
include ~/.config/sway/inputs
# [preference] autostart applications
include ~/.config/sway/autostart
# monitor settings
include ~/.config/sway/outputs
# style settings (really cool-looking, plz don't change them :D)
include ~/.config/sway/styles
# to make tiling great again, because why do I need prompts to take up half a screen
include ~/.config/sway/windowrules
# blanket to cry under
include /etc/sway/config.d/*
