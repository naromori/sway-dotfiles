# General screen settings (wallpaper and workspace-to-monitor mapping)
# Hardware-specific monitor declarations live in userprefs
output * bg /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png fill

# Bind Odd Workspaces to the Right Monitor
workspace 1 output $right_monitor
workspace 3 output $right_monitor
workspace 5 output $right_monitor
workspace 7 output $right_monitor
workspace 9 output $right_monitor

# Bind Even Workspaces to the Left Monitor
workspace 2 output $left_monitor
workspace 4 output $left_monitor
workspace 6 output $left_monitor
workspace 8 output $left_monitor
workspace 10 output $left_monitor
