# Window borders and gaps
default_border none
default_floating_border none
gaps inner 5
gaps outer 2

# Status bar
bar {
    position top
    status_command while date +'%Y-%m-%d %X'; do sleep 1; done

    colors {
        statusline #ffffff
        background #323232
        inactive_workspace #32323200 #32323200 #5c5c5c
    }
}
